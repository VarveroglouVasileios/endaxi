# ── Database ────────────────────────────────────────────────
# Neon ή Supabase — ΠΑΝΤΑ EU region για GDPR
DATABASE_URL="postgresql://user:pass@host/endaxi?sslmode=require"

# ── Auth ────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ── Inngest (background jobs) ───────────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── AI ──────────────────────────────────────────────────────
# ΠΡΟΣΟΧΗ: ενεργοποίησε zero-retention και δήλωσέ το στο DPA
ANTHROPIC_API_KEY=""

# ── Email ───────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=""   # inbound parsing (reconciliation module)
RESEND_API_KEY=""          # outbound
EMAIL_FROM="Εντάξει <noreply@endaxi.app>"

# ── Payments ────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Storage (Cloudflare R2) ─────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="endaxi-documents"

# ── Public ──────────────────────────────────────────────────
NUXT_PUBLIC_APP_URL="http://localhost:3000"
NUXT_PUBLIC_POSTHOG_KEY=""
