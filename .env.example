# ── Database ────────────────────────────────────────────────
# Neon ή Supabase — ΠΑΝΤΑ EU region για GDPR
DATABASE_URL="postgresql://user:pass@host/endaxi?sslmode=require"
# Μέγιστες PostgreSQL συνδέσεις ανά Azure instance (instances × max ≤ provider limit)
DATABASE_POOL_MAX="5"

# ── Auth ────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ── Inngest (background jobs) ───────────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Κάτω από το HTTP timeout του Azure App Service ώστε να προλαβαίνει checkpoint
INNGEST_MAX_RUNTIME="180s"

# ── AI ──────────────────────────────────────────────────────
# Πριν το production, έλεγξε Data Controls, DPA και τυχόν διεθνείς διαβιβάσεις
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# ── Shared rate limiting (Upstash Redis) ────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Email ───────────────────────────────────────────────────
RESEND_API_KEY=""          # outbound
EMAIL_FROM="Endaxi <noreply@endaxi.app>"

# ── Storage (Cloudflare R2) ─────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="endaxi-documents"

# ── Platform / proxy trust ──────────────────────────────────
# Βάλε "1" MONO στο Azure App Service (ή πίσω από ίδιο single-hop proxy).
# Χωρίς αυτό, τα rate limits και το session IP audit trail δεν βλέπουν το
# πραγματικό IP του client πίσω από τον Azure front-end.
TRUST_AZURE_PROXY=""

# ── Public ──────────────────────────────────────────────────
NUXT_PUBLIC_APP_URL="http://localhost:3000"
NUXT_PUBLIC_POSTHOG_KEY=""
NUXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
