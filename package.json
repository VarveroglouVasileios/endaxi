{
  "name": "endaxi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "description": "Είσαι εντάξει. — Compliance autopilot για βραχυχρόνια μίσθωση",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:verify": "tsx scripts/verify-integrity.ts",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "typecheck:test": "vue-tsc --noEmit -p tsconfig.test.json",
    "verify": "pnpm typecheck && pnpm typecheck:test && pnpm test"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.15",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "ai": "^7.0.40",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "h3": "1.15.11",
    "inngest": "^4.13.0",
    "ipaddr.js": "^2.4.0",
    "node-ical": "^0.27.1",
    "nuxt-security": "^2.6.0",
    "pdfmake": "^0.3.11",
    "postgres": "^3.4.9",
    "srvx": "^0.12.4",
    "undici": "^8.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/pdfmake": "^0.3.3",
    "drizzle-kit": "^0.31.10",
    "nuxt": "^4.5.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
